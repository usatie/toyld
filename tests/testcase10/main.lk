LINK
3 1 1
# segments: name base length flags
.text 0 8 RP
.data 0 10 RWP
.bss  0 8 RW
# symbols: name value seg_number type
main 0 1 D
# relocations: loc seg ref type
# A4: at offset 6 in segment 2 (.data), write the absolute base address of segment 3 (.bss)
# after storage allocation .bss lands at 0x2014, so mem[6..9] = 00 00 20 14 (big-endian)
6 2 3 A4
# data: hex-encoded bytes for segments with P flag (.text then .data)
# .text: 8 bytes of dummy instructions (no pointer slot — pointer lives in .data)
0011223344556677
# .data: 16 bytes — 6 bytes prefix + 4 bytes zero-initialized pointer to .bss + 6 bytes suffix
aaaaaaaaaaaa00000000bbbbbbbbbbbb
