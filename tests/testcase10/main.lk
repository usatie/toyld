LINK
3 1 1
# segments: name base length flags
.text 0 8 RP
.data 0 4 RWP
.bss  0 8 RW
# symbols: name value seg_number type
main 0 1 D
# relocations: loc seg ref type
# A4: at offset 4 in segment 1 (.text), write the absolute base address of segment 3 (.bss)
# after storage allocation .bss lands at 0x2008, so mem[4..7] = 00 00 20 08 (big-endian)
4 1 3 A4
# data: hex-encoded bytes for segments with P flag (.text then .data)
# .text: 4 bytes dummy instructions + 4 bytes zero-initialized pointer slot (filled by A4 relocation)
deadbeef00000000
# .data: 4 bytes of initialized data
cafebabe
